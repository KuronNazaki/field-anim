{
  "name": "field",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "vite",
    "serve": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
    "format:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\""
  },
  "dependencies": {
    "@canvas-commons/2d": "^0.4.0",
    "@canvas-commons/core": "^0.4.0",
    "@canvas-commons/ffmpeg": "^0.4.0",
    "@canvas-commons/vite-plugin": "^0.4.0"
  },
  "devDependencies": {
    "@canvas-commons/editor": "^0.4.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "tmp": "0.2.7",
    "ffmpeg-ffprobe-static": "^6.1.1"
  },
  "allowScripts": {
    "ffmpeg-ffprobe-static@6.1.1": true
  }
}
